# Neon pooled connection string (Neon console -> your project -> Connection Details
# -> "Pooled connection"). Set this as an env var named DATABASE_URL in the
# Vercel project settings — do not commit the real value.
DATABASE_URL=postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/sdc?sslmode=require

# Admin login (admin/index.html -> admin/dashboard.html) — single shared
# password, no per-user accounts. Pick any strong password.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. NOT the password — a separate random
# secret so a leaked cookie can't be reversed into ADMIN_PASSWORD, and so
# changing the password doesn't log everyone out. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=generate-a-random-64-char-hex-string
